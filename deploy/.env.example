# deploy/.env: copy this file to .env (same directory as docker-compose.yml)
# and fill it in. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate random values with:
#   openssl rand -hex 32    (64 hex chars, 32 bytes)
#   openssl rand -hex 24    (48 hex chars; good for passwords)
# Use hex (or other URL-safe) passwords: the database passwords are put into
# connection URLs unescaped.
#
# Compose reads this file for the ${VAR} substitutions in docker-compose.yml,
# and the orchestrator container also gets all of it as environment (env_file).

# --- Public names and addresses ---------------------------------------------

# Web UI hostname (DNS A/AAAA record -> VPS). Caddy gets its certificate.
FLEET_DOMAIN=fleet.example.com

# iroh relay hostname (DNS A/AAAA record -> VPS).
RELAY_DOMAIN=relay.example.com

# Contact address for Let's Encrypt (expiry notices).
ACME_EMAIL=admin@example.com

# Base URL of the web UI, used in magic links sent to Telegram.
FLEET_PUBLIC_URL=https://fleet.example.com

# The VPS's public IP and the orchestrator's QUIC port, advertised to nodes
# (`fleet orchestrator --public-addr`). An IP, not a hostname.
FLEET_PUBLIC_ADDR=203.0.113.10:7700

# Relay for the orchestrator's iroh endpoint: `none`, `n0` (n0's public
# relays), or a relay URL. Use the self-hosted relay from this stack.
# Nodes need the same value (systemd node.env, Windows -Relay).
FLEET_RELAY=https://relay.example.com

# --- Orchestrator secrets ----------------------------------------------------

# 32-byte key, hex-encoded (64 hex chars), that encrypts stored secrets (vault,
# bot tokens) at rest. Generate with:  openssl rand -hex 32
# Keep an offline copy: without it, the encrypted secrets in the database
# (and in its backups) cannot be read.
FLEET_MASTER_KEY=

# Orchestrator bot token from @BotFather (privacy mode disabled, see README).
TELEGRAM_ORCHESTRATOR_TOKEN=

# The fleet's Telegram supergroup (topics enabled). Starts with -100.
TELEGRAM_CHAT_ID=

# Your numeric Telegram user ID. Messages from anyone else are ignored.
TELEGRAM_OWNER_ID=

# Orchestrator log filter (tracing EnvFilter syntax).
RUST_LOG=info

# Model every agent and the brain use (a Claude Code --model value).
FLEET_MODEL=opus

# The project the orchestrator brain runs in. Map it on the VPS node to an empty
# directory (`fleet project map fleet ~/fleet-brain`); it is created automatically
# on the orchestrator side.
FLEET_BRAIN_PROJECT=fleet

# Optional: a self-hosted Telegram Bot API server instead of api.telegram.org.
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# Optional: run a released image instead of building locally, e.g.
# FLEET_IMAGE=ghcr.io/<github-owner>/fleet:0.1.0
# FLEET_IMAGE=

# --- Postgres ----------------------------------------------------------------
# All three are applied only when the postgres_data volume is first created.
# Changing them later does not change the passwords in the database (use
# ALTER ROLE ... PASSWORD, then update this file).

# Superuser `postgres` (maintenance and backups only).
POSTGRES_PASSWORD=

# Role `fleet`, owner of database `fleet` (the orchestrator's DATABASE_URL).
FLEET_DB_PASSWORD=

# Role `hindsight`, owner of database `hindsight`.
HINDSIGHT_DB_PASSWORD=

# --- Hindsight (memory) -----------------------------------------------------

# Image tag of ghcr.io/vectorize-io/hindsight.
HINDSIGHT_VERSION=1.2.1

# Anthropic API key Hindsight uses to extract facts from what agents retain.
HINDSIGHT_ANTHROPIC_API_KEY=

# Model for fact extraction (Hindsight's default for the anthropic provider).
HINDSIGHT_LLM_MODEL=claude-haiku-5-5

# Bearer token required on every Hindsight API and MCP request
# (Authorization: Bearer <key>). The brain and agents' MCP configs use it.
# Generate with:  openssl rand -hex 32
HINDSIGHT_API_KEY=

# Login key for the Hindsight control-plane UI (127.0.0.1:9999, via SSH tunnel).
HINDSIGHT_CP_ACCESS_KEY=

# Optional public hostname for Hindsight, for agents on remote nodes. Also
# uncomment the matching block at the end of the Caddyfile.
# MEMORY_DOMAIN=memory.example.com

# Hindsight as the AGENTS' hosts reach it. Every agent gets the MCP server
# <base>/mcp/<project>/ with the HINDSIGHT_API_KEY bearer token. Use
# http://127.0.0.1:8888 when all nodes run on the VPS host, or
# https://<MEMORY_DOMAIN> when Windows nodes need memory too. Leave empty to run
# without memory.
FLEET_HINDSIGHT_MCP_BASE=http://127.0.0.1:8888

# --- iroh relay --------------------------------------------------------------

# Image tag of n0computer/iroh-relay. Keep it in step with the iroh crate
# version in Cargo.lock.
IROH_RELAY_VERSION=v1.4.1

# Relay log filter.
IROH_RELAY_LOG=info

# Optional shared access token; see `access.shared_token` in iroh-relay.toml.
# IROH_RELAY_ACCESS_TOKEN=
