# deploy/.env: copy this file to .env (same directory as docker-compose.yml)
# and fill it in. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate random values with:
#   openssl rand -hex 32    (64 hex chars, 32 bytes)
#   openssl rand -hex 24    (48 hex chars; good for passwords)
# Use hex (or other URL-safe) passwords: the database passwords are put into
# connection URLs unescaped.
#
# Compose reads this file for the ${VAR} substitutions in docker-compose.yml,
# and the orchestrator container also gets all of it as environment (env_file).

# --- Public names and addresses ---------------------------------------------

# Web UI hostname (DNS A/AAAA record -> VPS). Caddy gets its certificate.
FLEET_DOMAIN=fleet.example.com

# iroh relay hostname (DNS A/AAAA record -> VPS).
RELAY_DOMAIN=relay.example.com

# Contact address for Let's Encrypt (expiry notices).
ACME_EMAIL=admin@example.com

# Base URL of the web UI, used in magic links sent to Telegram.
FLEET_PUBLIC_URL=https://fleet.example.com

# The VPS's public IP and the orchestrator's QUIC port, advertised to nodes
# (`fleet orchestrator --public-addr`). An IP, not a hostname.
FLEET_PUBLIC_ADDR=203.0.113.10:7700

# Relay for the orchestrator's iroh endpoint: `none`, `n0` (n0's public
# relays), or a relay URL. Use the self-hosted relay from this stack.
# Nodes need the same value (systemd node.env, Windows -Relay).
FLEET_RELAY=https://relay.example.com

# --- Orchestrator secrets ----------------------------------------------------

# 32-byte key, hex-encoded (64 hex chars), that encrypts stored secrets (vault,
# bot tokens) at rest. Generate with:  openssl rand -hex 32
# Keep an offline copy: without it, the encrypted secrets in the database
# (and in its backups) cannot be read.
FLEET_MASTER_KEY=

# Orchestrator bot token from @BotFather (privacy mode disabled, see README).
TELEGRAM_ORCHESTRATOR_TOKEN=

# The fleet's Telegram supergroup (topics enabled). Starts with -100.
TELEGRAM_CHAT_ID=

# Your numeric Telegram user ID. Messages from anyone else are ignored.
TELEGRAM_OWNER_ID=

# Orchestrator log filter (tracing EnvFilter syntax).
RUST_LOG=info

# Model every agent and the brain use (a Claude Code --model value).
# Prefer a full id over an alias: `opus` is resolved by whichever Claude CLI a node has, so
# two machines can quietly run the same task on different models, and nothing in the fleet
# would say which. Current ids: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5.
FLEET_MODEL=claude-opus-5-5

# What the orchestrator may choose per task (fleet agent create-task --model/--effort)
# and propose as an agent's defaults (admin agent-set). Comma lists. Unset: models
# FLEET_MODEL, sonnet and haiku; efforts low, medium and high. Bigger models and the
# xhigh/max efforts cost noticeably more per task, so they are yours to opt into here.
# Set but empty (FLEET_ALLOWED_MODELS=) allows nothing. Per-agent defaults you set on
# the web Agents page may use any valid value. A node whose Claude command sets --model
# or --effort keeps its own.
# FLEET_ALLOWED_MODELS=opus,sonnet,haiku
# FLEET_ALLOWED_EFFORTS=low,medium,high

# The project the orchestrator brain runs in. Map it on the VPS node to an empty
# directory (`fleet project map fleet ~/fleet-brain`); it is created automatically
# on the orchestrator side.
FLEET_BRAIN_PROJECT=fleet

# --- The secretary -----------------------------------------------------------
# A cheap session that triages every message from every conversation you are in
# (see docs/plan.md). It runs in FLEET_BRAIN_PROJECT, on the brain's node.

# Its model (a Claude Code --model value). It reads everything, so keep it cheap.
# FLEET_SECRETARY_MODEL=haiku

# Your IANA time zone, for the daily digest and times shown (Postgres names).
# FLEET_TIMEZONE=UTC

# The hour (0-23, in FLEET_TIMEZONE) of the silent daily digest; -1 turns it off.
# FLEET_SECRETARY_DIGEST_HOUR=9

# Batching: messages to you personally (DMs, group DMs, mentions) wait this many
# seconds for more; other traffic waits up to FLEET_SECRETARY_BATCH_SECS or until
# FLEET_SECRETARY_BATCH_SIZE are waiting. At most FLEET_SECRETARY_MAX_BATCH are
# shown per batch (the rest are counted), and at most
# FLEET_SECRETARY_TURNS_PER_HOUR batches run per hour.
# FLEET_SECRETARY_DEBOUNCE_SECS=30
# FLEET_SECRETARY_BATCH_SECS=600
# FLEET_SECRETARY_BATCH_SIZE=50
# FLEET_SECRETARY_MAX_BATCH=80
# FLEET_SECRETARY_TURNS_PER_HOUR=30

# Escalations to the orchestrator per hour at most; beyond that the secretary adds
# a todo instead.
# FLEET_SECRETARY_ESCALATIONS_PER_HOUR=10

# Retention: transcripts, mapped channels' messages, the secretary's triage log
# and the audit log (FLEET_RETENTION_DAYS), and messages of every other
# conversation (FLEET_FEED_RETENTION_DAYS).
# FLEET_RETENTION_DAYS=90
# FLEET_FEED_RETENTION_DAYS=90

# The daily retrospective (see docs/plan.md): once a day the fleet reads its own
# day and proposes improvements to itself in the 📈 Retro topic, where one tap
# turns a proposal into a task. Off until an hour is set (0-23, FLEET_TIMEZONE).
# One careful run a day, so a strong model and a high effort are worth it.
# FLEET_RETRO_HOUR=7
# FLEET_RETRO_MODEL=opus
# FLEET_RETRO_EFFORT=high
# FLEET_RETRO_MAX_PROPOSALS=3
# The project its proposals become tasks in: a clone of this repository, mapped
# on a node that can build it. Nothing else is ever touched by a proposal.
# FLEET_RETRO_PROJECT=fleet-src

# How many agents OF ONE ROLE a project may have. One agent runs one session at
# a time, so without this a project's tasks queue behind a single specialist.
# When a task would have to wait and some node still has a free slot, the
# orchestrator gives the project another agent (named "<first> 2") and the task
# starts at once. Per role, so a project may still have an implementor, a
# reviewer and a tester. 1 keeps a project's work strictly serial.
# Every concurrent agent is another Claude session against the same rate limit,
# so raise this only as far as the account can feed.
# FLEET_MAX_AGENTS_PER_PROJECT=3

# A finished task's topic is deleted once it has been quiet this long, so the
# forum does not fill up with work that is over (0 keeps every topic for ever).
# The bot needs the "Delete messages" admin right in the group as well as
# "Manage topics"; without it the orchestrator says so once and leaves them.
# A task picked up again gets a new topic.
# FLEET_TOPIC_DELETE_AFTER_MINUTES=60

# Optional: a self-hosted Telegram Bot API server instead of api.telegram.org.
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# Optional: run a released image instead of building locally, e.g.
# FLEET_IMAGE=ghcr.io/<github-owner>/fleet:0.1.0
# FLEET_IMAGE=

# --- Postgres ----------------------------------------------------------------
# All three are applied only when the postgres_data volume is first created.
# Changing them later does not change the passwords in the database (use
# ALTER ROLE ... PASSWORD, then update this file).

# Superuser `postgres` (maintenance and backups only).
POSTGRES_PASSWORD=

# Role `fleet`, owner of database `fleet` (the orchestrator's DATABASE_URL).
FLEET_DB_PASSWORD=

# Role `hindsight`, owner of database `hindsight`.
HINDSIGHT_DB_PASSWORD=

# --- Hindsight (memory) -----------------------------------------------------

# Image tag of ghcr.io/vectorize-io/hindsight.
HINDSIGHT_VERSION=1.2.1

# Anthropic API key Hindsight uses to extract facts from what agents retain.
HINDSIGHT_ANTHROPIC_API_KEY=

# Model for fact extraction (Hindsight's default for the anthropic provider).
HINDSIGHT_LLM_MODEL=claude-haiku-5-5

# Bearer token required on every Hindsight API and MCP request
# (Authorization: Bearer <key>). Only the orchestrator uses it: agents reach
# memory through the orchestrator (`fleet agent memory`), never directly.
# Generate with:  openssl rand -hex 32
HINDSIGHT_API_KEY=

# Login key for the Hindsight control-plane UI (127.0.0.1:9999, via SSH tunnel).
HINDSIGHT_CP_ACCESS_KEY=


# --- iroh relay --------------------------------------------------------------

# Image tag of n0computer/iroh-relay. Keep it in step with the iroh crate
# version in Cargo.lock.
IROH_RELAY_VERSION=v1.4.1

# Relay log filter.
IROH_RELAY_LOG=info

# Optional shared access token; see `access.shared_token` in iroh-relay.toml.
# IROH_RELAY_ACCESS_TOKEN=
