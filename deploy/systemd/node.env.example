# /etc/fleet/node.env: environment for fleet-node.service.
# systemd syntax: KEY=value, no `export`, no shell expansion ($HOME does NOT
# work here; write absolute paths). Replace /home/CHANGE_ME with the home of
# the service's User=.

# Where the node keeps its iroh key (node.key) and local state.
FLEET_DATA_DIR=/home/CHANGE_ME/.local/share/fleet

# Same relay as the orchestrator (FLEET_RELAY in deploy/.env).
FLEET_RELAY=https://relay.example.com

# systemd starts services with a minimal PATH. Include where `claude` lives
# (the native installer puts it in ~/.local/bin) and any toolchains agents need.
PATH=/home/CHANGE_ME/.local/bin:/home/CHANGE_ME/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUST_LOG=info

# Optional. Normally the node uses the Claude login already stored in
# ~/.claude (subscription). The per-node auth mode is set in the web UI; set a
# token here only if you want it to come from the service environment.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
